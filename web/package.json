{
  "name": "agentboard-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "dev:server": "npm run build && wrangler dev --port 8788",
    "deploy": "npm run build && wrangler deploy",
    "db:init:local": "wrangler d1 execute agentboard --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute agentboard --remote --file=./schema.sql"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240909.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "esbuild": "^0.24.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.3",
    "wrangler": "^4.20.0"
  }
}
